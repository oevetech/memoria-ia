{
  "memoria-ia": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/memoria.mjs contexto --ia agy",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/memoria.mjs guarda --ia agy",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/memoria.mjs lembrete --ia agy",
        "timeout": 15
      }
    ]
  }
}
