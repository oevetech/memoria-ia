{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),o=require('os'),f=require('fs'),u=require('url');const r=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT;let s=r&&p.join(r,'scripts','memoria.mjs');if(!s||!f.existsSync(s))s=p.join(o.homedir(),'.memoria-ia','memoria.mjs');import(u.pathToFileURL(s).href)\" contexto --ia codex",
            "timeout": 15,
            "commandWindows": "node -e \"const p=require('path'),o=require('os'),f=require('fs'),u=require('url');const r=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT;let s=r&&p.join(r,'scripts','memoria.mjs');if(!s||!f.existsSync(s))s=p.join(o.homedir(),'.memoria-ia','memoria.mjs');import(u.pathToFileURL(s).href)\" contexto --ia codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),o=require('os'),f=require('fs'),u=require('url');const r=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT;let s=r&&p.join(r,'scripts','memoria.mjs');if(!s||!f.existsSync(s))s=p.join(o.homedir(),'.memoria-ia','memoria.mjs');import(u.pathToFileURL(s).href)\" lembrete --ia codex",
            "timeout": 15,
            "commandWindows": "node -e \"const p=require('path'),o=require('os'),f=require('fs'),u=require('url');const r=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT;let s=r&&p.join(r,'scripts','memoria.mjs');if(!s||!f.existsSync(s))s=p.join(o.homedir(),'.memoria-ia','memoria.mjs');import(u.pathToFileURL(s).href)\" lembrete --ia codex"
          }
        ]
      }
    ]
  }
}
