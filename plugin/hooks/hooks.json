{
  "description": "memoria-ia: entrega a retomada do projeto no inicio e lembra de registrar marcos",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),o=require('os'),f=require('fs'),u=require('url');const h=o.homedir(),r=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT,c=process.env.CODEX_HOME||p.join(h,'.codex');const s=[r&&p.join(r,'scripts','memoria.mjs'),p.join(c,'.tmp','marketplaces','memoria-ia','plugin','scripts','memoria.mjs'),p.join(h,'.memoria-ia','memoria.mjs')].find(x=>x&&f.existsSync(x));if(s)import(u.pathToFileURL(s).href);else console.log('{}')\" contexto --ia claude",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),o=require('os'),f=require('fs'),u=require('url');const h=o.homedir(),r=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT,c=process.env.CODEX_HOME||p.join(h,'.codex');const s=[r&&p.join(r,'scripts','memoria.mjs'),p.join(c,'.tmp','marketplaces','memoria-ia','plugin','scripts','memoria.mjs'),p.join(h,'.memoria-ia','memoria.mjs')].find(x=>x&&f.existsSync(x));if(s)import(u.pathToFileURL(s).href);else console.log('{}')\" guarda --ia claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),o=require('os'),f=require('fs'),u=require('url');const h=o.homedir(),r=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT,c=process.env.CODEX_HOME||p.join(h,'.codex');const s=[r&&p.join(r,'scripts','memoria.mjs'),p.join(c,'.tmp','marketplaces','memoria-ia','plugin','scripts','memoria.mjs'),p.join(h,'.memoria-ia','memoria.mjs')].find(x=>x&&f.existsSync(x));if(s)import(u.pathToFileURL(s).href);else console.log('{}')\" lembrete --ia claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
